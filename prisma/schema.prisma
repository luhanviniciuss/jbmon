generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            Int       @id @default(autoincrement())
  username      String    @unique
  password_hash String
  x             Float     @default(1600)
  y             Float     @default(1600)
  world         String    @default("route") // mundo onde o jogador está: route | town | ice | lava
  role          String    @default("player") // "player" ou "admin" (só se concede pelo servidor: npm run make-admin)
  banned_until  DateTime? // conta banida até esta data (9999 = permanente)
  ban_reason    String?
  muted_until   DateTime? // silenciado no chat até esta data
  mute_reason   String?
  clan_id       Int?
  clan          Clan?     @relation(fields: [clan_id], references: [id], onDelete: SetNull)
  clan_role     String    @default("member") // "leader" | "officer" | "member"
  pvp_rating    Int       @default(1000)
  pvp_wins      Int       @default(0)
  pvp_losses    Int       @default(0)
  pokeballs     Int       @default(10)
  greatballs    Int       @default(0)
  ultraballs    Int       @default(0)
  masterballs   Int       @default(0)
  apricorns     Int       @default(0)
  shards        Int       @default(0)
  created_at    DateTime  @default(now())
  pokemons      Pokemon[]
  pokedex       PokedexEntry[]
  story         StoryProgress?
}

// Pokédex do jogador: visto (encontrado em batalha) e capturado (possui/possuiu o Pokémon)
model PokedexEntry {
  id              Int       @id @default(autoincrement())
  user_id         Int
  species_id      Int
  seen            Boolean   @default(true)
  caught          Boolean   @default(false)
  first_seen_at   DateTime  @default(now())
  first_caught_at DateTime?
  user            User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, species_id])
  @@map("user_pokedex")
}

// Progresso do Modo História: capítulo e missão atuais, contador da missão e situação das dicas (0 = pendente, 1 = vistas, 2 = puladas)
model StoryProgress {
  user_id    Int      @id
  chapter    Int      @default(1)
  step       Int      @default(0)
  count      Int      @default(0)
  tips       Int      @default(0)
  updated_at DateTime @updatedAt
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("player_progress")
}

model Pokemon {
  id          Int      @id @default(autoincrement())
  user_id     Int
  species_id  Int
  nickname    String?
  level       Int      @default(5)
  hp          Int      @default(20)
  current_hp  Int      @default(20)
  slot        Int? // posição na equipe (1 a 6); null = no box
  attack      Int      @default(10)
  defense     Int      @default(10)
  current_exp Int      @default(0)
  user        User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
}

// Pares chave/valor do mundo (ex.: quando o último boss apareceu, para manter o intervalo de 3 h mesmo após reinícios)
model Meta {
  key   String @id
  value String
}

// Auditoria: tudo que um administrador faz fica registrado aqui
model AdminLog {
  id         Int      @id @default(autoincrement())
  admin_id   Int
  admin_name String
  action     String
  target     String   @default("")
  details    String   @default("")
  created_at DateTime @default(now())
}

model Clan {
  id         Int      @id @default(autoincrement())
  name       String
  name_key   String   @unique // nome em minúsculas: unicidade sem diferenciar maiúsculas
  tag        String   @unique // 2-4 letras/números em maiúsculas
  points     Int      @default(0)
  wins       Int      @default(0)
  losses     Int      @default(0)
  created_at DateTime @default(now())
  members    User[]
}
