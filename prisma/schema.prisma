generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            Int       @id @default(autoincrement())
  username      String    @unique
  password_hash String
  x             Float     @default(1600)
  y             Float     @default(1600)
  pokeballs     Int       @default(10)
  greatballs    Int       @default(0)
  ultraballs    Int       @default(0)
  masterballs   Int       @default(0)
  apricorns     Int       @default(0)
  shards        Int       @default(0)
  created_at    DateTime  @default(now())
  pokemons      Pokemon[]
}

model Pokemon {
  id          Int      @id @default(autoincrement())
  user_id     Int
  species_id  Int
  nickname    String?
  level       Int      @default(5)
  hp          Int      @default(20)
  current_hp  Int      @default(20)
  slot        Int? // posição na equipe (1 a 6); null = no box
  attack      Int      @default(10)
  defense     Int      @default(10)
  current_exp Int      @default(0)
  user        User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
}

// Pares chave/valor do mundo (ex.: quando o último boss apareceu, para manter o intervalo de 3 h mesmo após reinícios)
model Meta {
  key   String @id
  value String
}
